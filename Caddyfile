# NimDrops edge configuration.
#
# One site block, one upstream. The Hono server is the whole origin: `/api/*`,
# the SSR campaign pages at `/d/:publicId`, the QR endpoint, the OG image and
# the SPA's static assets all come from it (design §4.1). Nothing here routes by
# path, because splitting the origin would put CORS on the money path.
#
# The hostname comes from PUBLIC_HOSTNAME in .env — no edit to this file is
# needed to go live. Caddy provisions the TLS certificate from that name and
# nothing else; the automatic HTTP→HTTPS redirect comes with it.
#
# Going live is three things: point an A/AAAA record at this host, set
# PUBLIC_HOSTNAME (and PUBLIC_ORIGIN=https://<same host>) in .env, then
# `docker compose up -d caddy`. Ports 80 and 443 must be reachable or the
# ACME challenge cannot complete.

# ---- who the client is -----------------------------------------------------
#
# THIS FILE IS THE ONLY CLOUDFLARE-AWARE PART OF THE SYSTEM. The app deals in
# one header and knows nothing about any edge (server/src/http/client-ip.ts).
#
# With Cloudflare in front, the socket peer is a Cloudflare edge address, so the
# real client is only knowable from `CF-Connecting-IP` — a header anyone who
# finds the origin can also send. Caddy is the only component positioned to tell
# those apart, because it can see the peer: `trusted_proxies` authenticates the
# edge by CIDR and `client_ip_headers` says which header that authenticated peer
# is allowed to speak through. `trusted_proxies_strict` then makes it a hard
# rule rather than a hint — a request from any other peer has its
# `CF-Connecting-IP` ignored outright.
#
# The result is `{client_ip}`, which is passed downstream as ONE header with a
# shared secret next to it, and every other spelling of "who am I" is stripped
# below so the app never has a second, weaker source to be confused by.
{
	servers {
		# CLOUDFLARE_PROXY_CIDRS comes from https://www.cloudflare.com/ips/ as a
		# space-separated list of the v4 AND v6 ranges. It is STATIC: Cloudflare
		# changes it occasionally, so re-read that page at deploy time. A range
		# that has been added but is missing here does not spoof anything — those
		# requests simply fall back to the peer address, i.e. one shared bucket.
		#
		# TEST-NET-1 fallback: valid syntax, but no real Cloudflare peer matches
		# it, so a deployment that forgot to populate the list fails safe.
		trusted_proxies static {$CLOUDFLARE_PROXY_CIDRS:192.0.2.0/24}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

# Reusable ingress guard for hostnames that are orange-cloud proxied. Match the
# immediate TCP peer, not client_ip: the latter is intentionally rewritten from
# CF-Connecting-IP for trusted Cloudflare peers. These sites share the existing
# Cloudflare Origin CA wildcard certificate, so no public ACME exception is
# required at the origin.
(cloudflare_only) {
	tls /etc/caddy/origin-certs/findling-origin.pem /etc/caddy/origin-certs/findling-origin.key

	@direct_origin {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	abort @direct_origin
}

# Public route for the primary Hexkit EDB bridge. Caddy provisions and renews
# the certificate after edb.hexkit.tech points at this host.
edb.hexkit.tech {
	reverse_proxy edb-primary:5789
}

# Findling shares this edge through the external public_proxy network. The
# application container publishes no host port; Caddy reaches it by its Compose
# service name instead. Its DNS record remains proxied by Cloudflare, and direct
# application requests to the origin are rejected by the shared guard.
findling.timidan.xyz {
	import cloudflare_only

	request_body {
		max_size 80MB
	}

	reverse_proxy findling:3000 {
		transport http {
			dial_timeout 180s
			read_timeout 180s
			write_timeout 180s
		}
	}
}

# Overcode is a versioned static release checked out on the host. It has no
# backend process or writable state; Caddy serves the repository's site tree
# through Cloudflare and rejects direct-origin application requests.
overcode.timidan.xyz {
	import cloudflare_only
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@immutable_assets path_regexp immutable_assets \.((?i:css|js|svg|png|jpe?g|webp|ico|mp4))$
	header @immutable_assets Cache-Control "public, max-age=2592000, immutable"

	root * /srv/overcode
	try_files {path} {path}/ /index.html
	file_server
}

# Nyx's private Nginx service preserves the original SPA, agent path rewrites,
# order-route bearer injection, body limit, and rate limit. Caddy authenticates
# Cloudflare and replaces X-Forwarded-For with the verified client address so
# the internal limiter cannot be influenced by a caller-supplied header.
nyx.timidan.xyz {
	import cloudflare_only

	reverse_proxy nyx-web:8080 {
		header_up X-Forwarded-For {client_ip}
		transport http {
			dial_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}

# AgentPay's private Nginx gateway is the only project container exposed to
# the shared proxy network. It preserves the original SPA fallback, /api and
# /bridge rewrites, rate limits, and long settlement/tool timeouts; the report,
# MCP, and facilitator processes remain on AgentPay's private networks.
agentpay.timidan.xyz {
	import cloudflare_only

	request_body {
		max_size 1MB
	}

	reverse_proxy agentpay-web:8080 {
		header_up X-Forwarded-For {client_ip}
		transport http {
			dial_timeout 30s
			read_timeout 240s
			write_timeout 240s
		}
	}
}

# Baton-X exposes only its ASP container to the proxy network. A2A, Hermes,
# OnchainOS, wallets, sessions, and encrypted replay stores remain on the
# project's private state/network boundary. Keep the loopback readiness probe
# unreachable from the public hostname, matching the source Nginx behavior.
baton.timidan.xyz {
	import cloudflare_only

	@internal_ready path /internal/ready
	respond @internal_ready 404

	reverse_proxy baton-x:3002 {
		transport http {
			dial_timeout 30s
			read_timeout 180s
			write_timeout 180s
		}
	}
}

{$PUBLIC_HOSTNAME} {
	import cloudflare_only
	encode zstd gzip

	# `server` is the compose service name (docker-compose.yml). Running Caddy on
	# the host instead of in compose? Use `127.0.0.1:8080`.
	reverse_proxy server:8080 {
		# The app's whole notion of "who is this" (rate-limit buckets, nothing
		# else). `{client_ip}` is what the block above derived: the Cloudflare-
		# supplied address when the peer WAS Cloudflare, the peer itself
		# otherwise. The secret is what proves this hop is us — without it the
		# header is just another thing an attacker can send straight to the
		# origin, and the app treats it as exactly that.
		header_up X-NimDrops-Client-IP {client_ip}
		header_up X-NimDrops-Proxy-Secret {$CADDY_APP_SHARED_SECRET}

		# Strip every competing claim on the way through. The app already ignores
		# all of these; removing them means a future middleware, log line or
		# library default cannot quietly resurrect one as a second source of
		# truth. X-Forwarded-For in particular is APPENDED by Caddy, so leaving
		# it would hand the app a list whose last entry is a Cloudflare address.
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up -CF-Connecting-IP
		header_up -CF-Connecting-IPv6

		# A slow chain RPC must not become a 502 mid-claim; the API's own timeouts
		# and the worker's advisory lock are the real bounds.
		transport http {
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
