# NimDrops edge configuration.
#
# One site block, one upstream. The Hono server is the whole origin: `/api/*`,
# the SSR campaign pages at `/d/:publicId`, the QR endpoint, the OG image and
# the SPA's static assets all come from it (design §4.1). Nothing here routes by
# path, because splitting the origin would put CORS on the money path.
#
# The hostname comes from PUBLIC_HOSTNAME in .env — no edit to this file is
# needed to go live. Caddy provisions the TLS certificate from that name and
# nothing else; the automatic HTTP→HTTPS redirect comes with it.
#
# Going live is three things: point an A/AAAA record at this host, set
# PUBLIC_HOSTNAME (and PUBLIC_ORIGIN=https://<same host>) in .env, then
# `docker compose up -d caddy`. Ports 80 and 443 must be reachable or the
# ACME challenge cannot complete.
{$PUBLIC_HOSTNAME} {
	encode zstd gzip

	# `server` is the compose service name (docker-compose.yml). Running Caddy on
	# the host instead of in compose? Use `127.0.0.1:8080`.
	#
	# Caddy APPENDS the real peer address to X-Forwarded-For, and `clientIp()` in
	# server/src/http/app.ts reads the LAST entry for exactly that reason: a
	# client-supplied prefix cannot be used to pick a rate-limit bucket.
	reverse_proxy server:8080 {
		# A slow chain RPC must not become a 502 mid-claim; the API's own timeouts
		# and the worker's advisory lock are the real bounds.
		transport http {
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format json
	}
}
